# Frontend environment — copy to .env.local and fill in your values

# Supabase (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Anthropic (for chat queries in dev)
VITE_ANTHROPIC_API_KEY=sk-ant-...

# Error tracking (optional, but recommended for production)
# Get your DSN from https://sentry.io — it looks like:
# https://[public]@[host]/[project-id]
VITE_SENTRY_DSN=

# Stripe (optional, for billing features)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
